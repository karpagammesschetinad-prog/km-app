{
  "name": "expense-salary-tracker",
  "version": "1.0.0",
  "description": "Expense tracking and employee salary management with Google Sheets",
  "main": "server.js",
  "scripts": {
    "start": "node -e \"process.env.NODE_ENV='production'; require('dotenv').config({ path: '.env.production' }); require('./server');\"",
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "nodemon server.js",
    "start:dev": "node server.js",
    "start:prod": "npm start",
    "migrate:dev:safe": "node scripts/safe-sheet-migrate.js development",
    "migrate:prod:safe": "node scripts/safe-sheet-migrate.js production"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "googleapis": "^140.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
